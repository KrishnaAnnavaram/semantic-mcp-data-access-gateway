{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(python -m acquisition.download_us_treasury *)",
      "Bash(python -m treasury_db.migrate *)",
      "Bash(python -m treasury_db.load *)",
      "Bash(python -m mcp_servers.host *)",
      "Bash(python tools/verify_load.py *)",
      "Bash(python tools/verify_mcp.py *)",
      "Bash(python -m pytest *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose exec postgres pg_isready *)",
      "Bash(docker exec smdag-postgres psql -U gateway -d gateway -c *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],

    "ask": [
      "Bash(docker compose down *)",
      "Bash(git push *)"
    ],

    "deny": [
      "Read(./adaptive-legacy-code-complexity-harness/**)",
      "Edit(./adaptive-legacy-code-complexity-harness/**)",
      "Write(./adaptive-legacy-code-complexity-harness/**)",
      "Edit(./data/raw/**)",
      "Write(./data/raw/**)",
      "Read(./.env)",
      "Read(./.claude/src/frontend/.env)"
    ]
  }
}

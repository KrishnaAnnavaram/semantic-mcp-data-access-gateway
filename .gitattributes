# Normalise line endings so a file's identity does not depend on which machine
# cloned it. This matters most for db/migrations/: the migration runner records
# a SHA-256 per applied file and refuses to run if one changes, and without this
# every migration looks "edited" on a fresh Windows checkout.

* text=auto

*.sql   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.csv   text eol=lf
*.xml   text eol=lf

# Raw source files are byte-immutable and their SHA-256 is recorded in
# download_manifest.json, which the loader checks before it will load anything.
# Line-ending normalisation rewrites those bytes and the hashes stop matching -
# on a machine with core.autocrlf=true the loader then refuses every file with
# "raw source files do not match the manifest". Treat them as binary so git
# never touches them. This rule must stay AFTER the *.xml rule above; in
# .gitattributes the last matching pattern wins.
data/raw/** -text

# Windows-only helpers keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touch binaries.
*.png   binary
*.jpg   binary
*.pdf   binary

# Copy to .env. Vite only exposes vars prefixed VITE_ to client code.

# rest -> talk to the real /chat service; mock -> canned local answers.
# Must be "rest" for real data, or the UI will silently serve mock answers
# forever with no error — check this first if answers look wrong.
VITE_AGENT_BACKEND=mock

# Where the FastAPI service (backend/) is listening.
VITE_AGENT_API_URL=http://localhost:8000

# How long the browser waits for /chat. Measured turns run 110-370s: one
# question is a Domain <-> MCP negotiation over several model calls. 60 was not
# enough for any of them, and the browser gave up while the backend went on to
# answer correctly.
#
# Matched to the backend's own bound instead of to a typical turn: the service
# caps a turn at A2A_TURN_TIMEOUT_SECONDS (900) and the A2A bridge adds 60, so
# /chat always replies within ~960 — with a stated reason when it failed.
# Waiting for that is what lets a real failure reach the user.
VITE_AGENT_TIMEOUT_SECONDS=960

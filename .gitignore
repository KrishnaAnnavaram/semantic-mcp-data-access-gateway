# Secrets
.env
frontend/.env
chatbot/.env
*.key

# Separate repository living inside this working directory. It carries its own
# .git — committing it produces a broken submodule reference or absorbs its
# history, neither of which is cleanly recoverable once pushed. See CLAUDE.md.
adaptive-legacy-code-complexity-harness/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Local vector store (embedded Qdrant, regenerated by ingest)
data/qdrant/
# Legacy location, kept ignored so older checkouts stay clean.
qdrant_db/

# Partially written raw downloads. A complete raw file is committed on purpose;
# a .part file is a download that never finished.
data/raw/**/*.part

# The default client root. Whatever a server writes here via the roots
# primitive is a regenerable export, never a source of record — keep the
# directory, ignore its contents.
data/exports/*
!data/exports/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

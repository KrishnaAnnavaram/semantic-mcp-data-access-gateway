# Copy to .env and adjust. .env is git-ignored and must stay that way.
#
# This one file drives both Docker Compose and the Python loader, so the two
# can never disagree about which database is being written to.

POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=gateway

# Host port. If a native PostgreSQL install is running it will already own
# 5432 — stop that service, or change this to 5433.
POSTGRES_PORT=5432

# Convenience URL for application code and psql clients on the host.
# Keep the password here in sync with POSTGRES_PASSWORD above; the loader
# prefers DATABASE_URL when both are present.
DATABASE_URL=postgresql://gateway:change-me-locally@localhost:5432/gateway

# --- MCP data server -------------------------------------------------------
# market-risk-data-mcp connects as this restricted role, never as the owner.
# The role is created by migration V009 without a password; set one here and
# run `python -m src.mcp_data.bootstrap` once to apply it.
MCP_READER_USER=mcp_reader
MCP_READER_PASSWORD=change-me-locally-too

# Optional. Signs pagination cursors so they survive a server restart.
# Leave unset locally and cursors simply do not outlive the process.
# MCP_CURSOR_KEY=

# --- Layer 2: reasoning agents ---
# Which LLM engine answers. Chosen exactly like DATA_BACKEND and QDRANT_URL:
#   zai       - GLM, via Z.AI's OpenAI-compatible endpoint  (the default)
#   anthropic - Claude, via the Anthropic Messages API
# Agents do not change when this changes; that is the point of the seam.
#
# This project runs on open weights by default, so a fresh checkout needs a
# ZAI_API_KEY. Set LLM_BACKEND=anthropic to run on Claude instead - that path is
# maintained and evaluated, not decorative.
LLM_BACKEND=zai

# Required when LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Required when LLM_BACKEND=zai. Never commit a real key - this file is a
# template and .env is git-ignored.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Model per call site. Leave unset to take the backend's defaults. Each site is
# independently overridable, so a split remains possible - it is simply not the
# shipped default.
#
# Under LLM_BACKEND=zai every call site defaults to glm-5.3:
#   ORCHESTRATOR_MODEL=glm-5.3
#   SAMPLING_MODEL=glm-5.3
#   MCP_AGENT_MODEL=glm-5.3
#   HOST_AGENT_MODEL=glm-5.3
#   DOMAIN_EXPERT_MODEL=glm-5.3
# Set one of these only to run a split; see llm/config.py for why glm-4.5-air
# is not the default anywhere (it measured 2/8 on the real routing schema).
#
# glm-5.2 is the previous default and is still supported - set any of these to
# it. It is measurably faster per turn (110-370s against 476-557s) and does not
# fill its reasoning ceiling the way glm-5.3 does. See README section 35.
# ORCHESTRATOR_MODEL=
# SAMPLING_MODEL=
# MCP_AGENT_MODEL=
# HOST_AGENT_MODEL=
# DOMAIN_EXPERT_MODEL=

# Wall clock for a single model call. GLM reasons before answering and is
# measurably slower than Claude; 300s leaves headroom without being unbounded.
# LLM_TIMEOUT_SECONDS=300
# LLM_MAX_RETRIES=2

# Vector store (Qdrant). Point at the server for the full stack; leave unset for
# an embedded local store at ./data/qdrant (no Docker). Compose uses http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Redis 8.8 shared intelligence ----------------------------------------
# Redis is optional and fail-open by default. It caches validated specialist
# work, coordinates identical misses, rate-limits LLM calls when configured,
# and records Streams/TimeSeries analytics. It is not the market-data or
# knowledge source of truth. Compose overrides REDIS_URL inside the agent
# container to redis://redis:6379/0.
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540
REDIS_MAXMEMORY=512mb
REDIS_CACHE_PREFIX=smcp
REDIS_NAMESPACE_VERSION=v1

# Central TTL and analytical-safety policy (seconds unless named otherwise).
REDIS_DOMAIN_RETRIEVAL_TTL=900
REDIS_DOMAIN_DERIVE_TTL=86400
REDIS_DOMAIN_REVISE_TTL=43200
REDIS_DOMAIN_VALIDATE_TTL=3600
REDIS_MCP_CATALOGUE_TTL=300
REDIS_MCP_ASSESS_TTL=21600
REDIS_MCP_CHOICES_TTL=300
REDIS_SEMANTIC_CACHE_ENABLED=true
REDIS_SEMANTIC_CACHE_TTL=86400
REDIS_SEMANTIC_SIMILARITY_THRESHOLD=0.93
REDIS_SEMANTIC_CANDIDATES=8

# Single-flight waits are bounded below the A2A turn deadline. Locks are
# ownership checked and released atomically.
REDIS_LOCK_TTL_MS=360000
REDIS_SINGLEFLIGHT_WAIT_SECONDS=310

# Zero deliberately disables a limit. Redis 8.8 INCREX enforces configured
# fixed-window caps atomically across processes.
REDIS_GLOBAL_LLM_RATE_LIMIT=0
REDIS_DOMAIN_LLM_RATE_LIMIT=0
REDIS_MCP_LLM_RATE_LIMIT=0
REDIS_LLM_RATE_WINDOW_SECONDS=60

# Bounded operational evidence.
REDIS_AGENT_STREAM_MAXLEN=50000
REDIS_QUESTION_FREQUENCY_MAX_ENTRIES=10000
REDIS_METRICS_RETENTION_SECONDS=2592000
REDIS_RUN_SUMMARY_TTL=604800

# How the agent reaches Treasury data:
#   mcp      - through market-risk-data-mcp as mcp_reader (the privilege boundary holds)
#   postgres - direct psycopg2 as the owner role (legacy; bypasses the boundary)
#   mock     - synthetic, for dev without a database
DATA_BACKEND=mcp

# Agent /chat service port on the host.
AGENT_PORT=8000

# Origins allowed to call /chat from a browser (comma-separated). The React
# frontend runs on a different origin (Vite dev server), so CORS must list it
# explicitly. Defaults already cover Vite's default dev port if left unset.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- A2A: agent-to-agent communication -------------------------------------
# A2A carries traffic *between* the three agents. MCP still carries tools and
# data; the two are not alternatives. Every value below has a working default,
# so a normal local setup needs none of them.

# How agents dial each other.
#   inprocess - through the mounted ASGI apps (default). Real JSON-RPC, real
#               task lifecycle, no second port to run.
#   http      - over the network, using the URLs below. Use this when an agent
#               is served from another process or host.
# A2A_TRANSPORT=inprocess

# Where agents live when A2A_TRANSPORT=http. A2A_BASE_URL sets the host for all
# three (each is then found at <base>/a2a/<agent>); the per-agent overrides win
# and let exactly one agent be moved without touching the other two.
# A2A_BASE_URL=http://localhost:8000
# A2A_ORCHESTRATOR_URL=http://localhost:8000/a2a/orchestrator
# A2A_DOMAIN_EXPERT_URL=http://localhost:8000/a2a/domain-expert
# A2A_MCP_URL=http://localhost:8000/a2a/mcp-agent

# Guardrails. Five bounds, because five different things run away.
#
# The call chain is the *path* a request has taken, recorded step by step
# (orchestrator.plan > domain-expert.derive > mcp-agent.assess). Its length
# bounds how deep a legitimate collaboration may go; re-entry bounds how often
# the same agent+skill may appear on that path, which is what actually catches
# a cycle. A flat depth counter conflates the two: it refuses an eight-step
# negotiation that never repeats itself, and permits A -> B -> A -> B until the
# depth runs out. Two separate numbers because they are two separate faults.
#
# The handoff budget bounds breadth, which neither of the above does.
#
# The deadline is on the whole TURN, not on each call. A call contains every
# call beneath it, so a flat per-call number makes the outermost call the
# tightest bound in the system and it expires first by construction — killing
# negotiations that were proceeding normally. Every call is bounded by what
# remains of the turn instead. Hang detection lives where hangs happen: the
# model layer's own LLM_TIMEOUT_SECONDS bounds every provider request.
# A2A_MAX_CHAIN=8
# A2A_MAX_REENTRY=3
# A2A_MAX_HANDOFFS=20
# A2A_TURN_TIMEOUT_SECONDS=900
# A2A_CALL_TIMEOUT_SECONDS=300   # floor under the turn budget

# How many times a clarification may be put again after the first ask, when the
# user's reply does not answer it. Three chances in all by default. Terminating
# on the first unmatched reply discards a request the user still wants; asking
# without a bound is the user-facing twin of an unbounded agent loop.
# A2A_MAX_CLARIFICATIONS=3

# Log level for the handoff log. Without it, uvicorn's logging configuration
# swallows the one record that lets you follow a request across three agents.
# A2A_LOG_LEVEL=INFO

# --- the requirement completeness gate --------------------------------------
# Before any retrieval or reasoning, the domain expert checks whether the
# question carries the inputs its analysis needs - deterministically, from the
# user's own words, with no model call and no vector search. An incomplete
# question is stopped there and one grouped clarification is asked, instead of
# spending four Qdrant queries and a reasoning call to discover that nobody
# named a comparison period.
#
# It is deliberately reluctant to ask. A field with a documented default
# (confidence level, holding period, observation window, as-of date) is never a
# reason to interrupt a senior quant; only a field no default can honestly stand
# in for may stop a turn - a comparison with no period, a stress with no
# scenario, a reverse stress with no target loss.
#
# Set false to restore exactly the previous flow. This is a way back that does
# not need a deploy, which is the difference between a rollout and a commitment.
# PREFLIGHT_ENABLED=true

# How many questions one clarification may carry. Three by default; five is the
# hard ceiling, because past that the user is filling in a form rather than
# having a conversation.
# PREFLIGHT_MAX_QUESTIONS=3

# How many times in a row the gate may stop a conversation before it proceeds on
# defaults and says which it used. Unbounded clarification is the user-facing
# twin of an unbounded agent loop.
# PREFLIGHT_MAX_ROUNDS=2

# --- live execution stream --------------------------------------------------
# GET /chat/stream/{request_id} (SSE) reports what the agents are doing while
# they do it: routing decisions, the requirement gate, retrievals, handoffs, MCP
# tool calls and model calls, each with its measured duration.
#
# The client chooses `request_id`, subscribes, THEN posts to /chat, so it is
# already watching before the first agent starts. The stream is a view and never
# a dependency: if nobody subscribes, or the connection drops, the turn answers
# identically.
#
# Nothing private is published. Prompts, completions, retrieved chunk text and
# any secret-looking metadata key are dropped at the source (agents/events.py),
# not by the UI choosing not to render them.
#
# How long the backend may spend reading a LangSmith trace back for the UI's
# Trace tab. Server-side only - the API key never reaches the browser.
# LANGSMITH_READ_TIMEOUT_SECONDS=8

# --- LangSmith observability ------------------------------------------------
# Traces, threads, latency, token/model metadata and evaluation for the whole
# three-agent turn. Purely observability: if LangSmith is disabled, absent, or
# unreachable, the gateway answers exactly as before — tracing is fail-open and
# never on the request path.
#
# Two things are needed to send traces: the flag AND a key. Setting one without
# the other is reported by /health (langsmith.reason) rather than failing quietly.
#
# NEVER expose LANGSMITH_API_KEY to the frontend. There is deliberately no
# VITE_LANGSMITH_* variable — LangSmith secrets stay backend-side only. The
# browser learns tracing status from /health, which never returns the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=semantic-mcp-data-access-gateway

# Optional. For EU or self-hosted LangSmith, point the ingest endpoint at your
# instance. Defaults to https://api.smith.langchain.com.
# LANGSMITH_ENDPOINT=

# Optional. For a multi-workspace API key, name the workspace runs belong to.
# LANGSMITH_WORKSPACE_ID=

# The legacy LANGCHAIN_* spellings of all of the above are still honoured, so an
# older .env keeps working:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=semantic-mcp-data-access-gateway
# LANGCHAIN_ENDPOINT=

# Optional dashboard/tag metadata stamped on every trace. All safe to expose;
# resolved automatically when unset (git commit from .git, version from
# pyproject, backends from the vars above).
# SMCP_ENV=local
# APP_VERSION=
# GIT_COMMIT=
